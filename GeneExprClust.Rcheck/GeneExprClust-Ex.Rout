> # Create sample gene expression data
> set.seed(123)
> data <- matrix(rnorm(200), nrow = 20, ncol = 10)
> rownames(data) <- paste0("Gene", 1:20)
> colnames(data) <- paste0("Sample", 1:10)
> 
> # Create cluster assignments
